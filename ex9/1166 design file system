#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>

typedef struct {
    pthread_mutex_t mtx;       // Mutex lock to protect state access
    pthread_cond_t cv_h;       // Condition variable for Hydrogen threads
    pthread_cond_t cv_o;       // Condition variable for Oxygen threads
    int hydrogen_count;        // Tracks the number of hydrogen threads processed in current molecule (0, 1, or 2)
} H2O;

// Function signatures provided by the environment
void releaseHydrogen();
void releaseOxygen();

H2O* h2oCreate() {
    H2O* obj = (H2O*) malloc(sizeof(H2O));
    
    // Initialize mutex and condition variables
    pthread_mutex_init(&obj->mtx, NULL);
    pthread_cond_init(&obj->cv_h, NULL);
    pthread_cond_init(&obj->cv_o, NULL);
    
    // Set initial tracking state to zero
    obj->hydrogen_count = 0;
    
    return obj;
}

void hydrogen(H2O* obj) {
    pthread_mutex_lock(&obj->mtx);
    
    // Wait if 2 hydrogen threads have already been released for the current group
    while (obj->hydrogen_count >= 2) {
        pthread_cond_wait(&obj->cv_h, &obj->mtx);
    }
    
    // releaseHydrogen() outputs "H". Do not change or remove this line.
    releaseHydrogen();
    
    // Increment the count of hydrogen threads in this group
    obj->hydrogen_count++;
    
    // If we have reached 2 hydrogens, signal the waiting oxygen thread to proceed
    if (obj->hydrogen_count == 2) {
        pthread_cond_signal(&obj->cv_o);
    } else {
        // Otherwise, signal another hydrogen thread if it's waiting
        pthread_cond_signal(&obj->cv_h);
    }
    
    pthread_mutex_unlock(&obj->mtx);
}

void oxygen(H2O* obj) {
    pthread_mutex_lock(&obj->mtx);
    
    // Wait until exactly 2 hydrogen threads have finished processing for the current group
    while (obj->hydrogen_count < 2) {
        pthread_cond_wait(&obj->cv_o, &obj->mtx);
    }
    
    // releaseOxygen() outputs "O". Do not change or remove this line.
    releaseOxygen();
    
    // Reset the counter to 0 to signal that a new molecule group can begin
    obj->hydrogen_count = 0;
    
    // Broadcast signal to waiting hydrogen threads to kickstart the next molecule
    pthread_cond_broadcast(&obj->cv_h);
    
    pthread_mutex_unlock(&obj->mtx);
}

void h2oFree(H2O* obj) {
    if (obj) {
        // Destroy synchronization primitives to prevent resource leaks
        pthread_mutex_destroy(&obj->mtx);
        pthread_cond_destroy(&obj->cv_h);
        pthread_cond_destroy(&obj->cv_o);
        
        // Free allocated structural object memory
        free(obj);
    }
}
